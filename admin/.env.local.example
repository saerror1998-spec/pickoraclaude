# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored by default (see .gitignore) — never commit real keys.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never exposed to the browser. Used for
# admin queries (orders, customers) that must bypass storefront RLS policies.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
