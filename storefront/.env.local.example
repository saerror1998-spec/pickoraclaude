# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored by default (see .gitignore) — never commit real keys.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by scripts/import-products.mjs (bulk product import) and
# at runtime for writing to the `orders` table (lib/orders.ts). Never used by
# app code that reaches the browser bundle. Run admin/supabase/schema.sql to
# create the `orders` table.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nomod hosted checkout (server-side only — never exposed to the browser).
# Nomod has no webhook system, so order status is reconciled by polling
# GET /v1/checkout/{id} from the checkout status pages — see lib/nomod.ts.
NOMOD_API_KEY=your-nomod-secret-key
NOMOD_API_BASE_URL=https://api.nomod.com

# ISO 4217 currency code used for pricing display and Nomod checkout sessions.
# Deliberately NEXT_PUBLIC_ (not sensitive) — ProductCard is rendered from a
# "use client" parent, so it runs client-side too, where a non-public env var
# would read as undefined and silently fall back to USD.
NEXT_PUBLIC_STORE_CURRENCY=USD
